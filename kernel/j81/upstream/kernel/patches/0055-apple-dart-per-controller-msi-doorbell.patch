diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -1137,14 +1137,41 @@
 #endif
 #define DOORBELL_ADDR	(CONFIG_PCIE_APPLE_MSI_DOORBELL_ADDR & PAGE_MASK)
 
+/*
+ * MSI doorbell page of the PCIe host bridge above a PCI device, if its controller node
+ * declares one with `apple,msi-doorbell` (a 64-bit address). The doorbell differs per
+ * controller generation (0xfffff000 on the M1 family, 0xbffff000 on the T7000 family), so
+ * it comes from the controller's own node rather than one global constant.
+ */
+static bool apple_dart_pci_msi_doorbell(struct device *dev, u64 *doorbell)
+{
+	struct pci_host_bridge *bridge = pci_find_host_bridge(to_pci_dev(dev)->bus);
+	struct device *parent = bridge ? bridge->dev.parent : NULL;
+
+	return parent && parent->of_node &&
+	       !of_property_read_u64(parent->of_node, "apple,msi-doorbell", doorbell);
+}
