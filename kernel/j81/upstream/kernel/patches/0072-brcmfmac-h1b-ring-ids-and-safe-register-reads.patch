+/*
+ * Patch 0072: window-moving reads are limited to registers that have been read safely before. Reading the PCIe2 core
+ * 0x00-0xff in one sweep (run 12, Q1) killed the USB link and rebooted the iPad, so arbitrary offsets are not allowed.
+ * PCIe2: 0x20 IntStatus, 0x24 IntMask, 0x48 mailbox int, 0x4c mailbox mask, 0x140/0x144 H2D mailboxes (all read by the
+ * stock driver or Apple's). ChipCommon: the GPIO block 0x58-0x6c plus 0xc40 and 0xe00 (read in runs 8-10).
+ */
+static bool h1b_q_reg_ok(u16 coreid, u32 off)
+{
+	if (coreid == BCMA_CORE_PCIE2)
+		return off == 0x20 || off == 0x24 || off == 0x48 || off == 0x4c || off == 0x140 || off == 0x144;
+	return (off >= 0x58 && off <= 0x6c) || off == 0xc40 || off == 0xe00;
+}
