{
  "overlay": "root-overlay",
  "remove_from_copied_root_only": [
    "etc/systemd/system/getty@tty1.service.d/20-j71b-platform.conf",
    "etc/systemd/system/multi-user.target.wants/j71b-charge.service",
    "etc/systemd/system/multi-user.target.wants/omarchy-diagnostics.service"
  ],
  "preserve_existing_tty1_autologin_and_labwc_session": true,
  "installer_must_generate": [
    "etc/j81/internal-root.conf with ROOT_UUID and exact qualified KERNEL_RELEASE",
    "etc/fstab with same UUID",
    "matching lib/modules for installed kernel"
  ],
  "diagnostic_ssh_must_be_reconfigured_for_J81": true,
  "runtime_unit_parser_verified": false,
  "root_pid1_handoff_tested": false,
  "applied_to_original_rootfs": false,
  "applied_to_ipad": false
}
