diff --git a/drivers/pci/controller/Kconfig b/drivers/pci/controller/Kconfig
--- a/drivers/pci/controller/Kconfig
+++ b/drivers/pci/controller/Kconfig
@@ -50,6 +50,23 @@ config PCIE_APPLE
 
 	  If unsure, say Y if you have an Apple Silicon system.
 
+config PCIE_APPLE_T7000
+	tristate "Apple T7000 PCIe compile-only skeleton"
+	depends on ARCH_APPLE || COMPILE_TEST
+	depends on OF
+	help
+	  Build inert groundwork for the older Apple PCIe host controller in
+	  T7000-family SoCs. The current driver only verifies the number of
+	  firmware-described register windows and port interrupts, then refuses
+	  to bind because clock, PHY, MSI, DART and link-training support is not
+	  implemented yet. Its matching T7001 topology is disabled in the device
+	  tree, so the probe is not reached by a normal boot.
+
+	  This driver does not map or access MMIO, request interrupts or GPIOs,
+	  enable power or clocks, start link training, or enumerate a PCI bus.
+
+	  If unsure, say N.
+
 config PCI_VERSATILE
 	bool "ARM Versatile PB PCI controller"
 	depends on ARCH_VERSATILE || COMPILE_TEST
