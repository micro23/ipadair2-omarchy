diff --git a/drivers/pci/controller/pcie-apple-t7000.c b/drivers/pci/controller/pcie-apple-t7000.c
--- a/drivers/pci/controller/pcie-apple-t7000.c
+++ b/drivers/pci/controller/pcie-apple-t7000.c
@@ -647,6 +647,42 @@
 static inline void t7000_pcie_debugfs(struct device *dev, void __iomem *ctrl) { }
 #endif
 
+#ifdef CONFIG_PCIE_APPLE_T7000_DEVICE_WAKE_TEST
+/*
+ * Test only (patch 0067): drive the endpoint's DEVICE_WAKE input high. iOS drives it through
+ * AppleEmbeddedPCIEPort::setDeviceWake() while the Wi-Fi device is active, and the proven NVRAM
+ * (device_wake_opt=1) makes the firmware depend on it to leave deep sleep. Off unless the boot
+ * argument pcie_apple_t7000.device_wake=1 is given; the descriptor is held for the device's life.
+ */
+static bool t7000_device_wake;
+module_param_named(device_wake, t7000_device_wake, bool, 0444);
+MODULE_PARM_DESC(device_wake, "J81 test: assert the Wi-Fi DEVICE_WAKE GPIO (165) after link-up");
+
+static void t7000_pcie_device_wake(struct device *dev)
+{
+	struct device_node *child;
+	struct gpio_desc *desc;
+
+	if (!t7000_device_wake)
+		return;
+	for_each_child_of_node(dev->of_node, child) {
+		if (!of_node_is_type(child, "pci"))
+			continue;
+		desc = devm_fwnode_gpiod_get_index(dev, of_fwnode_handle(child), "device-wake", 0,
+						   GPIOD_OUT_HIGH, "t7000-device-wake");
+		if (IS_ERR(desc))
+			dev_err(dev, "t7000-pcie: DEVICE_WAKE GPIO unavailable: %ld\n", PTR_ERR(desc));
+		else
+			dev_info(dev, "t7000-pcie: DEVICE_WAKE asserted, GPIO reads %d\n", gpiod_get_value(desc));
+		of_node_put(child);
+		return;
+	}
+	dev_warn(dev, "t7000-pcie: no root-port node for DEVICE_WAKE\n");
+}
+#else
+static inline void t7000_pcie_device_wake(struct device *dev) { }
+#endif
