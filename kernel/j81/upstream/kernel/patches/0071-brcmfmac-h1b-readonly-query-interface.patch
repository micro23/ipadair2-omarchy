+/*
+ * Patch 0071: raw words of the three host/firmware shared regions (shared structure, ring info, common-ring memory
+ * table). Firmware and host configuration only (no calibration, no firmware code); read-only TCM reads.
+ */
+static void h1b_dump_region(struct brcmf_pciedev_info *devinfo, const char *what, u32 addr, u32 bytes)
+{
+	u32 buf[64];
+	u32 i, n = min_t(u32, bytes / 4, ARRAY_SIZE(buf));
+
+	for (i = 0; i < n; i++)
+		buf[i] = brcmf_pcie_read_tcm32(devinfo, addr + i * 4);
+	dev_info(&devinfo->pdev->dev, H1B_PREFIX "%s @ tcm 0x%08x (%u bytes):\n", what, addr, n * 4);
+	print_hex_dump(KERN_INFO, H1B_PREFIX, DUMP_PREFIX_OFFSET, 16, 4, buf, n * 4, false);
+}
+
+static void h1b_dump_shared_regions(struct brcmf_pciedev_info *devinfo)
+{
+	u32 ring_info = devinfo->shared.ring_info_addr;
+
+	h1b_dump_region(devinfo, "shared structure", devinfo->shared.tcm_base_address, 0x68);
+	if (!ring_info)
+		return;
+	h1b_dump_region(devinfo, "ring info", ring_info, 0x40);
+	h1b_dump_region(devinfo, "common ring memory", brcmf_pcie_read_tcm32(devinfo, ring_info), 0x50);
+}
