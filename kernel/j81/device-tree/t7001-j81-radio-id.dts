		watchdog@20e027000 {
			compatible = "apple,t7000-wdt\0apple,wdt";
			reg = <0x02 0xe027000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x04 0x04>;
		};

		interrupt-controller@20e100000 {
			compatible = "apple,t7000-aic\0apple,aic";
			reg = <0x02 0xe100000 0x00 0x100000>;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			power-domains = <0x28>;
			phandle = <0x01>;
		};

		pinctrl@20e300000 {
			compatible = "apple,t7000-pinctrl\0apple,pinctrl";
			reg = <0x02 0xe300000 0x00 0x100000>;
			power-domains = <0x29>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x1e 0x00 0x00 0xb8>;
			apple,npins = <0xb8>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x3e 0x04 0x00 0x3f 0x04 0x00 0x40 0x04 0x00 0x41 0x04 0x00 0x42 0x04 0x00 0x43 0x04 0x00 0x44 0x04>;
			phandle = <0x1e>;

			i2c0-pins {
				pinmux = <0x10026 0x10025>;
				phandle = <0x0d>;
			};

			i2c1-pins {
				pinmux = <0x10042 0x10041>;
				phandle = <0x10>;
			};

			i2c2-pins {
				pinmux = <0x10085 0x10084>;
				phandle = <0x12>;
			};

			i2c3-pins {
				pinmux = <0x10087 0x10086>;
				phandle = <0x14>;
			};

			uart3-pins {
				pinmux = <0x2000e 0x20020>;
				phandle = <0x08>;
			};

			uart5-pins {
				pinmux = <0x10022>;
				phandle = <0x0a>;
			};

			spi3-pins {
				pinmux = <0x10033>;
				phandle = <0x0c>;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupt-names = "phys\0virt";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04>;
	};

	pmu {
		compatible = "apple,typhoon-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x4b 0x04 0x00 0x4e 0x04 0x00 0x51 0x04>;
		interrupt-affinity = <0x2a 0x2b 0x2c>;
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer {
			compatible = "apple,simple-framebuffer\0simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			power-domains = <0x26 0x2d>;
			status = "disabled";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-home {
			label = "Home Button";
			gpios = <0x1e 0x00 0x01>;
			linux,code = <0xac>;
			wakeup-source;
		};

		button-power {
			label = "Power Button";
			gpios = <0x1e 0x01 0x01>;
			linux,code = <0x74>;
			wakeup-source;
		};

		button-volup {
			label = "Volume Up";
			gpios = <0x1e 0x5c 0x01>;
			linux,code = <0x73>;
		};

		button-voldown {
			label = "Volume Down";
			gpios = <0x1e 0x5d 0x01>;
			linux,code = <0x72>;
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x08 0x00 0x00 0x00>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};
};
