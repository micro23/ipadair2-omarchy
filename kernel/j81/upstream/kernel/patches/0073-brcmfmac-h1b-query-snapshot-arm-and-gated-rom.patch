+			h1b_q_printf("error: tcm needs absolute ARM addresses inside the RAM (0x%x..0x%x), OFF,LEN multiples of 4, 0 < LEN <= 0x%x\n",
+				     devinfo->ci ? devinfo->ci->rambase : 0, devinfo->ci ? devinfo->ci->rambase + devinfo->ci->ramsize : 0,
+				     H1B_Q_TCM_MAX);
 			return;
 		}
 		h1b_q_tcm(devinfo, "tcm", off, len);
@@ -2614,6 +2718,49 @@
 			}
 		}
 		h1b_q_core(devinfo, id, which, off, len);
+	} else if (!strcmp(cmd, "snap")) {
+		if (!devinfo->ci) {
+			h1b_q_printf("error: no chip\n");
+			return;
+		}
+		h1b_q_snap(devinfo);
+	} else if (!strcmp(cmd, "diff")) {
+		if (!devinfo->ci) {
+			h1b_q_printf("error: no chip\n");
+			return;
+		}
+		h1b_q_diff(devinfo);
+	} else if (!strcmp(cmd, "arm")) {
+		if (!h1b_hold_mask || !devinfo->ci) {
+			h1b_q_printf("error: arm needs brcmfmac.h1b_hold=1\n");
+			return;
+		}
+		h1b_q_arm(devinfo);
+	} else if (!strcmp(cmd, "unlock rom")) {
+		if (!h1b_hold_mask || !devinfo->ci) {
+			h1b_q_printf("error: rom reads need brcmfmac.h1b_hold=1\n");
+			return;
+		}
+		h1b_rom_unlocked = true;
+		dev_warn(&devinfo->pdev->dev, "t7000-h1b: ROM reads unlocked (BAR2 0x%llx bytes, RAM base 0x%x)\n",
+			 (unsigned long long)pci_resource_len(devinfo->pdev, 2), devinfo->ci->rambase);
+		h1b_q_printf("rom reads unlocked: BAR2 0x%llx bytes, RAM base 0x%x, max 0x%x bytes per read, offsets below the RAM base only\n",
+			     (unsigned long long)pci_resource_len(devinfo->pdev, 2), devinfo->ci->rambase, H1B_Q_ROM_MAX);
+	} else if (sscanf(cmd, "rom %i %i", &off, &len) == 2) {
+		u64 bar2 = pci_resource_len(devinfo->pdev, 2);
+
+		if (!h1b_rom_unlocked) {
