diff --git a/arch/arm64/boot/dts/apple/t7001.dtsi b/arch/arm64/boot/dts/apple/t7001.dtsi
--- a/arch/arm64/boot/dts/apple/t7001.dtsi
+++ b/arch/arm64/boot/dts/apple/t7001.dtsi
@@ -33,6 +33,18 @@
 		#clock-cells = <0>;
 		clock-frequency = <24000000>;
 		clock-output-names = "clkref";
+	};
+
+	/*
+	 * SPI3's functional clock: ADT spi3 `clock-ids` = 0x12e, low byte 0x2e = entry 46 of the arm-io `clock-frequencies` table = 60,000,000 Hz (the same lookup that gives
+	 * the UART's 24 MHz). With the 24 MHz placeholder the divider was computed for the wrong rate and every transfer ran about 2.5 times faster than requested
+	 * (measured: 1.74 us/byte at a requested 1.984 MHz; research/2026-10-12-spi3-clock.md).
+	 */
+	clk_spi3: clock-spi3 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <60000000>;
+		clock-output-names = "clk_spi3";
 	};
 
 	cpus {
@@ -212,7 +224,7 @@
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 155 IRQ_TYPE_LEVEL_HIGH>;
 			/* Use the bootloader-enabled clocks for now. */
-			clocks = <&clkref>;
+			clocks = <&clk_spi3>;
 			power-domains = <&ps_spi3>;
 			pinctrl-0 = <&spi3_pins>;
 			pinctrl-names = "default";
