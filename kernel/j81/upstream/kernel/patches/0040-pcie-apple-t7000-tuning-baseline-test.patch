+static void t7000_pcie_enable_port_hardware(struct device *dev,
+					     void __iomem *shared, int port)
+{
+	u32 off = port * T7000_PCIE_PORT_STRIDE;
+	u32 ltssm_off = T7000_PCIE_LTSSM_BASE + port * T7000_PCIE_LTSSM_STRIDE;
+	u32 v;
 
+	v = readl(shared + T7000_PCIE_LINK_ENABLE + off);
+	writel(v & ~BIT(0), shared + T7000_PCIE_LINK_ENABLE + off);
+
+	v = readl(shared + T7000_PCIE_PERST_INTERNAL + off);
+	writel(v | BIT(0), shared + T7000_PCIE_PERST_INTERNAL + off);
+
+	udelay(10);
+
+	v = readl(shared + T7000_PCIE_UNKNOWN_10C + off);
+	writel(v & ~BIT(0), shared + T7000_PCIE_UNKNOWN_10C + off);
+
+	v = readl(shared + T7000_PCIE_REFCLK_EN + off);
+	writel(v | BIT(0), shared + T7000_PCIE_REFCLK_EN + off);
+
+	v = readl(shared + T7000_PCIE_REFCLK_EN + off);
+	writel(v | T7000_PCIE_REFCLK_EN_MUXED_AUXCLK_AUTO_DIS,
+	       shared + T7000_PCIE_REFCLK_EN + off);
+
+	udelay(100); /* t-refclk-to-perst, confirmed 100us on J81 */
+
+	v = readl(shared + T7000_PCIE_LINK_ENABLE + off);
+	writel(v | BIT(0), shared + T7000_PCIE_LINK_ENABLE + off);
+
+	v = readl(shared + T7000_PCIE_PERST_INTERNAL + off);
+	writel(v & ~T7000_PCIE_PERST_INTERNAL_BIT8,
+	       shared + T7000_PCIE_PERST_INTERNAL + off);
+
+	writel(3, shared + ltssm_off);
+
+	/* enableGated's own repeat of the final _enablePortHardware write. */
+	writel(3, shared + ltssm_off);
+}
