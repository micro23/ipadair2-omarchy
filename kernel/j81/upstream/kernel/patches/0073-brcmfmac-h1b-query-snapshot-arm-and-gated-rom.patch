+/*
+ * Patch 0073: whole-RAM snapshot and diff (is the firmware's RAM changing, i.e. is the ARM running?), ARM/PCIe2/ChipCommon
+ * core-up state, and gated ROM reads. ROM reads (addresses below the RAM base through the same BAR2 window) are refused
+ * until "unlock rom" has been issued in this boot, need brcmfmac.h1b_hold=1, are limited to 0x1000 bytes per command and
+ * to the BAR2 size, and are logged before they are issued. An unmapped or unimplemented read may fault the bus (a PCIe2
+ * register sweep in run 12 rebooted the iPad), which is why the unlock is a separate, deliberate step.
+ */
+#define H1B_Q_ROM_MAX		0x1000
+#define H1B_Q_DIFF_LINES	400
+
+static u32 *h1b_snap;
+static u32 h1b_snap_base;
+static u32 h1b_snap_bytes;
+static bool h1b_rom_unlocked;
+
+static u32 *h1b_q_read_ram(struct brcmf_pciedev_info *devinfo, u32 *base, u32 *bytes)
+{
+	u32 *buf;
+
+	*base = devinfo->ci->rambase;
+	*bytes = devinfo->ci->ramsize & ~3u;
+	buf = kvmalloc(*bytes, GFP_KERNEL);
+	if (buf)
+		brcmf_pcie_copy_dev_tomem(devinfo, *base, buf, *bytes);
+	return buf;
+}
+
+static void h1b_q_snap(struct brcmf_pciedev_info *devinfo)
+{
+	u32 base, bytes;
+	u32 *buf = h1b_q_read_ram(devinfo, &base, &bytes);
+
+	if (!buf) {
+		h1b_q_printf("error: out of memory\n");
+		return;
+	}
+	kvfree(h1b_snap);
+	h1b_snap = buf;
+	h1b_snap_base = base;
+	h1b_snap_bytes = bytes;
+	h1b_q_printf("snapshot of RAM 0x%x..0x%x taken\n", base, base + bytes);
+}
+
+static void h1b_q_diff(struct brcmf_pciedev_info *devinfo)
+{
+	u32 base, bytes, i, changed = 0, shown = 0;
+	u32 *buf;
+
+	if (!h1b_snap) {
+		h1b_q_printf("error: no snapshot (run snap first)\n");
+		return;
+	}
+	buf = h1b_q_read_ram(devinfo, &base, &bytes);
+	if (!buf) {
+		h1b_q_printf("error: out of memory\n");
+		return;
+	}
+	if (base != h1b_snap_base || bytes != h1b_snap_bytes) {
+		kvfree(buf);
+		h1b_q_printf("error: RAM geometry changed since the snapshot\n");
+		return;
+	}
+	for (i = 0; i < bytes / 4; i++) {
+		if (buf[i] == h1b_snap[i])
+			continue;
+		changed++;
+		if (shown < H1B_Q_DIFF_LINES) {
+			h1b_q_printf("diff %08x: %08x -> %08x\n", base + i * 4, h1b_snap[i], buf[i]);
+			shown++;
+		}
+	}
+	h1b_q_printf("changed words: %u of %u (%u shown)\n", changed, bytes / 4, shown);
+	kvfree(h1b_snap);
+	h1b_snap = buf;
+}
+
+static void h1b_q_arm(struct brcmf_pciedev_info *devinfo)
+{
+	static const struct { u16 id; const char *name; } cores[] = {
+		{ BCMA_CORE_ARM_CR4, "arm_cr4" }, { BCMA_CORE_PCIE2, "pcie2" }, { BCMA_CORE_CHIPCOMMON, "chipcommon" },
+	};
+	int i;
+
+	if (devinfo->irq_allocated)
+		disable_irq(devinfo->pdev->irq);
+	for (i = 0; i < ARRAY_SIZE(cores); i++) {
+		struct brcmf_core *core = brcmf_chip_get_core(devinfo->ci, cores[i].id);
+
+		if (core)
+			h1b_q_printf("%s: rev %u base 0x%08x up %d\n", cores[i].name, core->rev, core->base,
+				     brcmf_chip_iscoreup(core));
+		else
+			h1b_q_printf("%s: absent\n", cores[i].name);
+	}
+	brcmf_pcie_select_core(devinfo, BCMA_CORE_PCIE2);
+	if (devinfo->irq_allocated)
+		enable_irq(devinfo->pdev->irq);
+}
+
 static void h1b_q_run(struct brcmf_pciedev_info *devinfo, const char *cmd)
 {
