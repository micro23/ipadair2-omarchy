 }
 
 
+#ifdef CONFIG_BRCMFMAC_PCIE_H1B_DIAG
+/*
+ * Test only (patch 0070): make the shared-memory content the host provides match Apple's bus driver
+ * (iOS 8.1 FUN_c05974). Bit mask, 0 = stock Linux:
+ *   1 = do not provide the ring-update DMA buffer (Apple never writes shared +0x40/+0x44),
+ *   2 = scratch buffer of 4096 bytes instead of 8 (Apple writes shared +0x34 = 0x1000),
+ *   4 = Apple's common-ring depths 128/256/128/256/256 instead of 64/1024/64/1024/1024.
+ */
+#define H1B_SHARED_NO_RINGUPD	1
+#define H1B_SHARED_SCRATCH_4K	2
+#define H1B_SHARED_APPLE_DEPTH	4
+
+static unsigned int h1b_apple_shared_mask;
+module_param_named(h1b_apple_shared, h1b_apple_shared_mask, uint, 0444);
+MODULE_PARM_DESC(h1b_apple_shared, "J81 test: bit 0 no ringupd buffer, bit 1 4 KiB scratch, bit 2 Apple ring depths");
+
+static const u32 h1b_apple_max_item[BRCMF_NROF_COMMON_MSGRINGS] = { 128, 256, 128, 256, 256 };
+
+static u32 h1b_ring_max_item(u32 ring_id)
+{
+	if (h1b_apple_shared_mask & H1B_SHARED_APPLE_DEPTH)
+		return h1b_apple_max_item[ring_id];
+	return brcmf_ring_max_item[ring_id];
+}
+
+static u32 h1b_scratch_len(void)
+{
+	return (h1b_apple_shared_mask & H1B_SHARED_SCRATCH_4K) ? 4096 : BRCMF_DMA_D2H_SCRATCH_BUF_LEN;
+}
+
+static bool h1b_skip_ringupd(void)
+{
+	return h1b_apple_shared_mask & H1B_SHARED_NO_RINGUPD;
+}
+#else
+static inline u32 h1b_ring_max_item(u32 ring_id) { return brcmf_ring_max_item[ring_id]; }
+static inline u32 h1b_scratch_len(void) { return BRCMF_DMA_D2H_SCRATCH_BUF_LEN; }
+static inline bool h1b_skip_ringupd(void) { return false; }
+#endif
+
