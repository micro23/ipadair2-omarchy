 	t7000_pcie_wait_link_active(dev, cfg, ctrl);
+
+	t7000_pcie_debugfs(dev, ctrl);
 
 	dev_dbg(dev, "t7000-pcie: init complete, handing back to the generic ECAM core\n");
 
