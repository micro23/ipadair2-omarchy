+#ifdef CONFIG_BRCMFMAC_PCIE_H1B_DIAG
+/*
+ * Test-only Wi-Fi H1B diagnostics (patch 0065). Read-only: it logs what the host gave the firmware
+ * (ring/scratch IOVAs and their IOMMU translation), the endpoint MSI capability and interrupt chain
+ * while bound, every interrupt as it is taken, and the ring state when the firmware is declared dead.
+ * It writes no register, TCM word or memory, and dumps only protocol headers, never firmware RAM.
+ */
+#define H1B_PREFIX "t7000-h1b: "
+static atomic_t h1b_isr_count = ATOMIC_INIT(0);
+
+static void h1b_log_domain(struct brcmf_pciedev_info *devinfo)
+{
+	struct iommu_domain *dom = iommu_get_domain_for_dev(&devinfo->pdev->dev);
+	u16 cmd = 0;
+
+	pci_read_config_word(devinfo->pdev, PCI_COMMAND, &cmd);
+	if (!dom) {
+		dev_info(&devinfo->pdev->dev, H1B_PREFIX "no IOMMU domain; pci command 0x%04x\n", cmd);
+		return;
+	}
+	dev_info(&devinfo->pdev->dev, H1B_PREFIX "iommu domain type 0x%x aperture %pad..%pad force %d; pci command 0x%04x\n",
+		 dom->type, &dom->geometry.aperture_start, &dom->geometry.aperture_end,
+		 dom->geometry.force_aperture, cmd);
+}
+
+static void h1b_log_dma(struct brcmf_pciedev_info *devinfo, const char *what, dma_addr_t iova, u32 size)
+{
+	struct iommu_domain *dom = iommu_get_domain_for_dev(&devinfo->pdev->dev);
+	phys_addr_t phys = dom ? iommu_iova_to_phys(dom, iova) : 0;
+
+	dev_info(&devinfo->pdev->dev, H1B_PREFIX "dma %s: size %u iova %pad -> phys %pa\n", what, size, &iova, &phys);
+}
+
+static void h1b_log_msi(struct brcmf_pciedev_info *devinfo, const char *when)
+{
+	struct pci_dev *pdev = devinfo->pdev;
+	struct irq_data *d;
+	u16 ctl = 0, data = 0;
+	u32 lo = 0, hi = 0;
+	int pos = pdev->msi_cap;
+
+	if (pos) {
+		pci_read_config_word(pdev, pos + PCI_MSI_FLAGS, &ctl);
+		pci_read_config_dword(pdev, pos + PCI_MSI_ADDRESS_LO, &lo);
+		if (ctl & PCI_MSI_FLAGS_64BIT) {
+			pci_read_config_dword(pdev, pos + PCI_MSI_ADDRESS_HI, &hi);
+			pci_read_config_word(pdev, pos + PCI_MSI_DATA_64, &data);
+		} else {
+			pci_read_config_word(pdev, pos + PCI_MSI_DATA_32, &data);
+		}
+	}
+	dev_info(&pdev->dev, H1B_PREFIX "msi %s: irq %d msi_enabled %d ctl 0x%04x addr 0x%08x_%08x data %u\n",
+		 when, pdev->irq, pdev->msi_enabled, ctl, hi, lo, data);
+	for (d = irq_get_irq_data(pdev->irq); d; d = d->parent_data)
+		dev_info(&pdev->dev, H1B_PREFIX "  irq chain: domain %s hwirq %lu\n",
+			 d->domain && d->domain->name ? d->domain->name : "?", d->hwirq);
+}
+
+static void h1b_isr_note(struct brcmf_pciedev_info *devinfo, int irq, u32 status)
+{
+	u32 n = atomic_inc_return(&h1b_isr_count);
+
+	if (n <= 32)
+		dev_info(&devinfo->pdev->dev, H1B_PREFIX "isr #%u irq %d mailbox status 0x%x\n", n, irq, status);
+}
+
+/* Ring state as host and device see it, plus the control rings' first items (protocol headers). */
+static void h1b_dump_rings(struct brcmf_pciedev_info *devinfo, const char *why)
+{
+	struct device *dev = &devinfo->pdev->dev;
+	int i;
+
+	dev_info(dev, H1B_PREFIX "ring snapshot (%s): isr count %d, mailbox int 0x%x\n", why,
+		 atomic_read(&h1b_isr_count), brcmf_pcie_read_reg32(devinfo, devinfo->reginfo->mailboxint));
+	h1b_log_domain(devinfo);
+	h1b_log_msi(devinfo, "at snapshot");
+	for (i = 0; i < BRCMF_NROF_COMMON_MSGRINGS; i++) {
+		struct brcmf_pcie_ringbuf *ring = devinfo->shared.commonrings[i];
+
+		if (!ring)
+			continue;
+		dev_info(dev, H1B_PREFIX "ring %d: depth %u item %u iova %pad host r/w %u/%u device r %u w %u\n", i,
+			 ring->commonring.depth, ring->commonring.item_len, &ring->dma_handle,
+			 ring->commonring.r_ptr, ring->commonring.w_ptr,
+			 devinfo->read_ptr(devinfo, ring->r_idx_addr), devinfo->read_ptr(devinfo, ring->w_idx_addr));
+	}
+	/* Ring 0 = control submit (host writes), ring 2 = control complete (device writes). */
+	for (i = 0; i <= 2; i += 2) {
+		struct brcmf_pcie_ringbuf *ring = devinfo->shared.commonrings[i];
+
+		if (ring && ring->commonring.buf_addr && ring->commonring.item_len >= 32)
+			dev_info(dev, H1B_PREFIX "ring %d first item: %*phN\n", i, 32, ring->commonring.buf_addr);
+	}
+	if (devinfo->shared.scratch)
+		dev_info(dev, H1B_PREFIX "d2h scratch (device-written via DMA): %*phN\n", 8, devinfo->shared.scratch);
+}
+#else
+static inline void h1b_log_domain(struct brcmf_pciedev_info *devinfo) { }
+static inline void h1b_log_dma(struct brcmf_pciedev_info *devinfo, const char *what, dma_addr_t iova, u32 size) { }
+static inline void h1b_log_msi(struct brcmf_pciedev_info *devinfo, const char *when) { }
+static inline void h1b_isr_note(struct brcmf_pciedev_info *devinfo, int irq, u32 status) { }
+static inline void h1b_dump_rings(struct brcmf_pciedev_info *devinfo, const char *why) { }
+#endif
