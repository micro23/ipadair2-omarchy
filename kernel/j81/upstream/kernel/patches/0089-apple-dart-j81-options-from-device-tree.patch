diff --git a/drivers/iommu/io-pgtable-dart.c b/drivers/iommu/io-pgtable-dart.c
--- a/drivers/iommu/io-pgtable-dart.c
+++ b/drivers/iommu/io-pgtable-dart.c
@@ -27,13 +27,13 @@
 #include "iommu-pages.h"
 
 /*
- * Test only (patch 0088): io_pgtable_dart.ios_leaf_bits=N ORs N (low 12 bits) into every iOS-format leaf entry on top of the fixed bit 1.
- * Runs 34/35: with ios_pte the DART accepts the directory entry (|3) but reports NO PTE for a present leaf (|2); Apple's decompile shows an
- * extra flag in bit 0 that the lookup returns as `& 1`. This lets the boot arguments try bit 0 (=1) and other candidates without a rebuild.
- */
-static unsigned int ios_leaf_bits;
+ * iOS-format S5L8960X leaf entries are (pfn << 12) | 3 (patch 0088, now the default): bit 1 plus bit 0. Apple's decompile writes `| 2` and the lookup returns a
+ * flag in bit 0; on the real J81 DART a leaf with only bit 1 is ignored (NO PTE FOR IOVA) and bits 1+0 translate (run 37, D19). io_pgtable_dart.ios_leaf_bits
+ * is kept as an override: the value (low 12 bits) is ORed in on top of bit 1 for experiments (0 reproduces the old `| 2` leaf).
+ */
+static unsigned int ios_leaf_bits = 1;
 module_param(ios_leaf_bits, uint, 0444);
-MODULE_PARM_DESC(ios_leaf_bits, "J81 test: extra low bits ORed into iOS-format DART leaf entries");
+MODULE_PARM_DESC(ios_leaf_bits, "J81: low bits ORed into iOS-format DART leaf entries on top of bit 1 (default 1 = leaf | 3)");
 
 #define DART1_MAX_ADDR_BITS	36
 
