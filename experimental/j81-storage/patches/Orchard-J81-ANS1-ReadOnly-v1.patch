diff --git a/Documentation/devicetree/bindings/block/apple,s5l8960x-ans.yaml b/Documentation/devicetree/bindings/block/apple,s5l8960x-ans.yaml
new file mode 100644
index 000000000..4fb0acf40
--- /dev/null
+++ b/Documentation/devicetree/bindings/block/apple,s5l8960x-ans.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/block/apple,s5l8960x-ans.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple ANS1 storage controller
+
+maintainers:
+  - Nick Chan <towinchenmi@gmail.com>
+
+properties:
+  compatible:
+    oneOf:
+      - const: apple,s5l8960x-ans
+      - items:
+          - enum:
+              - apple,t7000-ans
+              - apple,t7001-ans
+          - const: apple,s5l8960x-ans
+
+  reg:
+    maxItems: 1
+    description: AKF co-processor control registers
+
+  power-domains:
+    maxItems: 1
+    description: ANS1 CPU and mailbox power domain
+
+  mboxes:
+    maxItems: 1
+    description: Mailbox of the ANS1 co-processor
+
+  resets:
+    maxItems: 1
+
+  memory-region:
+    maxItems: 1
+    description: Region containing ANS1 firmware
+
+  memory-region-names:
+    const: firmware
+
+required:
+  - compatible
+  - reg
+  - power-domains
+  - mboxes
+  - resets
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    block@8040000 {
+      compatible = "apple,t7000-ans", "apple,s5l8960x-ans";
+      reg = <0x8040000 0x40000>;
+      mboxes = <&ans_mbox>;
+      power-domains = <&ps_ans>;
+      resets = <&ps_ans>;
+    };
diff --git a/Documentation/devicetree/bindings/mailbox/apple,mailbox.yaml b/Documentation/devicetree/bindings/mailbox/apple,mailbox.yaml
index 28985cc62..300a63680 100644
--- a/Documentation/devicetree/bindings/mailbox/apple,mailbox.yaml
+++ b/Documentation/devicetree/bindings/mailbox/apple,mailbox.yaml
@@ -35,9 +35,10 @@ properties:
           - const: apple,asc-mailbox-v4
 
       - description:
-          An older ASC mailbox interface found on T2 and A11 that is also
-          used for the NVMe coprocessor and the system management
-          controller.
+          The oldest ASC mailbox interface as well as a 96-bit variant
+          of the AKF mailbox with similar behaviours are found on T2 and
+          A11 and is used for the NVMe coprocessor and system management
+          coprocessor.
         items:
           - const: apple,t8015-asc-mailbox
 
@@ -52,6 +53,16 @@ properties:
               - apple,t6000-m3-mailbox
           - const: apple,m3-mailbox-v2
 
+      - description:
+          AKF mailboxes with 64-bit messages are found on A7 - A10 SoCs
+          connecting to Cortex-A7 coprocessors such as the storage
+          controller and power management processor.
+        items:
+          - enum:
+              - apple,t7000-akf-mailbox-v1
+              - apple,s5l8960x-akf-mailbox-v1
+          - const: apple,akf-mailbox-v1
+
   reg:
     maxItems: 1
 
