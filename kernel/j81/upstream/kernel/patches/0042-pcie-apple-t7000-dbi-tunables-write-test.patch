+static void t7000_pcie_rmw(struct device *dev, void __iomem *base,
+			    const char *label, u32 offset, u32 clear_mask,
+			    u32 set_value)
+{
+	u32 old = readl(base + offset);
+
+	writel((old & ~clear_mask) | set_value, base + offset);
+	dev_info(dev,
+		 "t7000-pcie dbi-write-test: %s 0x%05x: 0x%08x -> 0x%08x\n",
+		 label, offset, old, readl(base + offset));
+}
+
 /*
+ * Stage 5C: the actual gated RMW, following Apple's own confirmed order
+ * (research/t7000-pcie-hardware-findings.md's "Real PCIe host-controller
+ * driver, Stage 4b" section onward): dbi-overrides first, gated by
+ * saving the DBI control register, setting its low bit, applying the
+ * three records, then restoring the saved value -- then
+ * apcie-config-tunables through the direct port-controller window. No
+ * MSI or firmware work -- out of scope for this experiment, same as
+ * every prior stage.
+ */
+static void t7000_pcie_apply_dbi_overrides(struct device *dev,
+					    struct pci_config_window *cfg)
+{
+	u32 saved;
+	int i;
+
+	saved = readl(cfg->win + T7000_PCIE_DBI_GATE_ECAM_OFFSET);
+	dev_info(dev,
+		 "t7000-pcie dbi-write-test: dbi gate saved=0x%08x, setting saved|1\n",
+		 saved);
+	writel(saved | 1, cfg->win + T7000_PCIE_DBI_GATE_ECAM_OFFSET);
+
+	for (i = 0; i < 3; i++)
+		t7000_pcie_rmw(dev, cfg->win, "dbi-override",
+			       t7000_pcie_dbi_overrides[i].offset,
+			       t7000_pcie_dbi_overrides[i].clear_mask,
+			       t7000_pcie_dbi_overrides[i].set_value);
+
+	writel(saved, cfg->win + T7000_PCIE_DBI_GATE_ECAM_OFFSET);
+	dev_info(dev,
+		 "t7000-pcie dbi-write-test: dbi gate restored to 0x%08x (readback 0x%08x)\n",
+		 saved, readl(cfg->win + T7000_PCIE_DBI_GATE_ECAM_OFFSET));
+}
+
+static void t7000_pcie_apply_config_tunables(struct device *dev,
+					      void __iomem *ctrl)
+{
+	int i;
+
+	for (i = 0; i < 3; i++)
+		t7000_pcie_rmw(dev, ctrl, "config-tunable",
+			       t7000_pcie_config_tunables[i].offset,
+			       t7000_pcie_config_tunables[i].clear_mask,
+			       t7000_pcie_config_tunables[i].set_value);
+}
+
