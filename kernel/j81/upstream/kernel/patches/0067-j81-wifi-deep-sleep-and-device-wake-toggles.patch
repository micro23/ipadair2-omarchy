+#ifdef CONFIG_BRCMFMAC_PCIE_H1B_DIAG
+/*
+ * Test only (patch 0067): how the host answers the firmware's deep-sleep request.
+ * 0 = stock (mailbox word plus the config-space SBMBX write), 1 = no acknowledgement (log only),
+ * 2 = Apple's way: mailbox word plus an MMIO write of 1 to H2D mailbox 1 (core +0x144).
+ */
+static int h1b_ds_ack_mode;
+module_param_named(h1b_ds_ack, h1b_ds_ack_mode, int, 0444);
+MODULE_PARM_DESC(h1b_ds_ack, "J81 test: 0 stock deep-sleep ACK, 1 none, 2 ACK via MMIO H2D mailbox 1");
+
+static void h1b_send_ds_ack(struct brcmf_pciedev_info *devinfo)
+{
+	struct device *dev = &devinfo->pdev->dev;
+	u32 addr = devinfo->shared.htod_mb_data_addr;
+
+	switch (h1b_ds_ack_mode) {
+	case 1:
+		dev_info(dev, "t7000-h1b: deep sleep request NOT acknowledged (h1b_ds_ack=1)\n");
+		return;
+	case 2:
+		if (brcmf_pcie_read_tcm32(devinfo, addr)) {
+			dev_info(dev, "t7000-h1b: host mailbox word still pending, ACK skipped (h1b_ds_ack=2)\n");
+			return;
+		}
+		brcmf_pcie_write_tcm32(devinfo, addr, BRCMF_H2D_HOST_DS_ACK);
+		brcmf_pcie_write_reg32(devinfo, devinfo->reginfo->h2d_mailbox_1, 1);
+		dev_info(dev, "t7000-h1b: deep sleep ACK sent by MMIO H2D mailbox 1 (h1b_ds_ack=2)\n");
+		return;
+	default:
+		brcmf_pcie_send_mb_data(devinfo, BRCMF_H2D_HOST_DS_ACK);
+	}
+}
+#else
+static inline void h1b_send_ds_ack(struct brcmf_pciedev_info *devinfo)
+{
+	brcmf_pcie_send_mb_data(devinfo, BRCMF_H2D_HOST_DS_ACK);
+}
+#endif
+
