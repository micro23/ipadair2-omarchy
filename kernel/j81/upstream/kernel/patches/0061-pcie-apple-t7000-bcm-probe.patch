diff --git a/drivers/pci/controller/Kconfig b/drivers/pci/controller/Kconfig
--- a/drivers/pci/controller/Kconfig
+++ b/drivers/pci/controller/Kconfig
@@ -72,6 +72,19 @@
 
 	  If unsure, say N.
 
+config PCIE_APPLE_T7000_BCM_PROBE
+	bool "Apple T7000 PCIe BCM4350 metadata observation probe (test kernels only)"
+	depends on PCIE_APPLE_T7000=y
+	help
+	  Binds to the J81 BCM4350 at boot, reads a small fixed set of ChipCommon
+	  metadata registers through the BAR0 window, logs them with the NVM
+	  mapping path they select, restores the window and declines the device.
+	  It writes nothing but the BAR0 window register, reads no NVM shadow
+	  bytes, and never enables bus mastering. Not for production kernels;
+	  do not combine with PCIE_APPLE_T7000_MSI_SELFTEST (same device).
+
+	  If unsure, say N.
+
 config PCI_VERSATILE
 	bool "ARM Versatile PB PCI controller"
 	depends on ARCH_VERSATILE || COMPILE_TEST
