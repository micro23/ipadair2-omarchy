From 4e6837f70934d305afa5ab26340ae9c0d3ef4c77 Mon Sep 17 00:00:00 2001
From: Micro <micro@Micros-MacBook-Air.local>
Date: Thu, 29 Oct 2026 11:00:39 -0400
Subject: [PATCH] Stop RAM bootstrap children on timeout

---
 src/orchard_cli/boot.py |  6 +++---
 tests/test_ram.py       | 22 +++++++++++++++++++++-
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/src/orchard_cli/boot.py b/src/orchard_cli/boot.py
index 19a0e55..4c8cf6c 100644
--- a/src/orchard_cli/boot.py
+++ b/src/orchard_cli/boot.py
@@ -26,7 +26,7 @@ def boot_ram(output, *, yes=False):
     """Boot once via existing USB/Pongo transport. No recovery API required."""
     from orchard_hardware import device as hardware_device
     from .apple import usb
-    from .apple.boot import wait_mode
+    from .apple.boot import run_process_group, wait_mode
     from .state import operation_lock
     from .transports import pongo
 
@@ -67,8 +67,8 @@ def boot_ram(output, *, yes=False):
         if device['mode'] == 'dfu':
             print('Starting Pongo once. Inspect any uncertain failure before retrying.')
             with (output / 'palera1n.log').open('wb') as log:
-                subprocess.run([executable, '-p', '-k', str(output / 'pongo.bin')],
-                               check=True, timeout=120, stdout=log, stderr=subprocess.STDOUT)
+                run_process_group([executable, '-p', '-k', str(output / 'pongo.bin')],
+                                  timeout=120, stdout=log, stderr=subprocess.STDOUT)
             wait_mode(device, 'pongo', chip=chip, board=board, product='', seconds=60)
         usb.selected(device['location'], ecid, chip=chip, board=board)
         pongo.upload(output / 'linux.bin', device['location'], receipt['files']['linux.bin'])
diff --git a/tests/test_ram.py b/tests/test_ram.py
index b059047..d2e2d95 100644
--- a/tests/test_ram.py
+++ b/tests/test_ram.py
@@ -331,7 +331,7 @@ class RamTests(unittest.TestCase):
                 patch('orchard_cli.state.operation_lock', return_value=nullcontext()), \
                 patch('orchard_cli.apple.boot.wait_mode') as wait, \
                 patch.object(boot.shutil, 'which', return_value='/fake/palera1n'), \
-                patch.object(boot.subprocess, 'run') as execute:
+                patch('orchard_cli.apple.boot.run_process_group') as execute:
             boot.boot_ram(self.output, yes=True)
         selected.assert_any_call('fake', 123, chip=0x8011, board=0x04, mode='dfu')
         selected.assert_any_call('fake', 123, chip=0x8011, board=0x04)
@@ -339,6 +339,26 @@ class RamTests(unittest.TestCase):
         execute.assert_called_once()
         upload.assert_called_once()
 
+    def test_dfu_bootstrap_timeout_stops_before_upload_without_retry(self):
+        self.build()
+        device = dict(mode='dfu', chip=0x8011, board=0x04, ecid=123, location='fake')
+        with patch('orchard_cli.apple.usb.sole_target', return_value=device), \
+                patch('orchard_cli.apple.usb.selected'), \
+                patch('orchard_cli.transports.pongo.upload') as upload, \
+                patch('orchard_cli.state.operation_lock', return_value=nullcontext()), \
+                patch('orchard_cli.apple.boot.wait_mode') as wait, \
+                patch.object(boot.shutil, 'which', return_value='/fake/palera1n'), \
+                patch('orchard_cli.apple.boot.run_process_group',
+                      side_effect=subprocess.TimeoutExpired('palera1n', 120)) as execute, \
+                self.assertRaises(subprocess.TimeoutExpired):
+            boot.boot_ram(self.output, yes=True)
+        execute.assert_called_once()
+        self.assertEqual(execute.call_args.args[0],
+                         ['/fake/palera1n', '-p', '-k', str(self.output / 'pongo.bin')])
+        self.assertEqual(execute.call_args.kwargs['timeout'], 120)
+        wait.assert_not_called()
+        upload.assert_not_called()
+
     def test_mismatch_refusal_stops_before_usb_mutation(self):
         self.build()
         device = dict(mode='pongo', chip=0x8011, board=0x04, ecid=123, location='fake')
