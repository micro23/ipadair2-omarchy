 }
 
+#ifdef CONFIG_APPLE_DART_H1B_DIAG
+/*
+ * Read-only register dump for the J81 Wi-Fi bring-up (patch 0066), S5L8960X only: the translation
+ * control, the latched error status and address (reading them does not clear anything; the fault flag
+ * is cleared by a write in the interrupt handler) and the four TTBRs of each of the four streams.
+ * Exposed as /sys/kernel/debug/apple-dart-<dev>/regs so a failed DMA run can be inspected afterwards.
+ */
+static void apple_dart_h1b_debugfs(struct apple_dart *dart)
+{
+	static const struct debugfs_reg32 regs[] = {
+		{ "tcr", DART_S5L8960X_TCR },
+		{ "error", DART_S5L8960X_ERROR },
+		{ "error_addr", DART_S5L8960X_ERROR_ADDR },
+		{ "ttbr_s0_0", DART_S5L8960X_TTBR + 0x00 }, { "ttbr_s0_1", DART_S5L8960X_TTBR + 0x04 },
+		{ "ttbr_s0_2", DART_S5L8960X_TTBR + 0x08 }, { "ttbr_s0_3", DART_S5L8960X_TTBR + 0x0c },
+		{ "ttbr_s1_0", DART_S5L8960X_TTBR + 0x10 }, { "ttbr_s1_1", DART_S5L8960X_TTBR + 0x14 },
+		{ "ttbr_s1_2", DART_S5L8960X_TTBR + 0x18 }, { "ttbr_s1_3", DART_S5L8960X_TTBR + 0x1c },
+	};
+	struct debugfs_regset32 *regset;
+	struct dentry *dir;
+	char *name;
+
+	if (dart->hw->type != DART_S5L8960X)
+		return;
+	regset = devm_kzalloc(dart->dev, sizeof(*regset), GFP_KERNEL);
+	name = devm_kasprintf(dart->dev, GFP_KERNEL, "apple-dart-%s", dev_name(dart->dev));
+	if (!regset || !name)
+		return;
+	regset->regs = regs;
+	regset->nregs = ARRAY_SIZE(regs);
+	regset->base = dart->regs;
+	dir = debugfs_create_dir(name, NULL);
+	debugfs_create_regset32("regs", 0444, dir, regset);
+}
+#else
+static inline void apple_dart_h1b_debugfs(struct apple_dart *dart) { }
+#endif
+
 static int apple_dart_probe(struct platform_device *pdev)
 {
 	int ret;
@@ -1420,6 +1462,8 @@
 	ret = iommu_device_register(&dart->iommu, &apple_dart_iommu_ops, dev);
 	if (ret)
 		goto err_sysfs_remove;
+
+	apple_dart_h1b_debugfs(dart);
 
 	dev_info(
 		&pdev->dev,
