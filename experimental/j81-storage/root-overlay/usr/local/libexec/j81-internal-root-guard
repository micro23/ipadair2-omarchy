#!/bin/bash
# Installed root policy: require the intended native J81 ext4 root, never NFS.
set -euo pipefail
fail() { printf 'J81 internal-root guard: %s\n' "$*" >&2; exit 1; }
[[ -r /proc/device-tree/compatible ]] || fail 'missing board identity'
tr '\000' '\n' < /proc/device-tree/compatible | grep -Fxq apple,j81 || fail 'wrong board'
tr '\000' '\n' < /proc/device-tree/compatible | grep -Fxq apple,t7001 || fail 'wrong chip family'
config=/etc/j81/internal-root.conf
[[ -f $config && ! -L $config && $(stat -c %u "$config") == 0 ]] || fail 'root identity configuration absent'
mode=$(stat -c %a "$config")
(( (8#$mode & 8#022) == 0 )) || fail 'root configuration is writable by other users'
release=$(sed -n 's/^KERNEL_RELEASE=\([a-zA-Z0-9._+-]*\)$/\1/p' "$config")
[[ -n $release && $(uname -r) == "$release" ]] || fail 'installed kernel differs from qualified release'
expected=$(sed -n 's/^ROOT_UUID=\([0-9a-fA-F-]*\)$/\1/p' "$config")
[[ $expected =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || fail 'invalid root UUID'
[[ $(findmnt -n -o FSTYPE /) == ext4 ]] || fail 'root is not ext4'
source=$(findmnt -n -o SOURCE /)
[[ $(readlink -f "$source") == /dev/asp0n1p1 ]] || fail 'root is not the USERAREA Linux partition'
actual=$(blkid -s UUID -o value /dev/asp0n1p1)
[[ ${actual,,} == ${expected,,} ]] || fail 'root filesystem UUID changed'
[[ $(cat /sys/class/block/asp0n1/ro) == 0 ]] || fail 'USERAREA is read-only'
[[ $(cat /sys/module/asp/parameters/allow_userarea_writes) == Y ]] || fail 'USERAREA write mode absent'
first=$(cat /sys/module/asp/parameters/write_first_lba)
count=$(cat /sys/module/asp/parameters/write_lba_count)
start=$(cat /sys/class/block/asp0n1p1/start)
size=$(cat /sys/class/block/asp0n1p1/size)
[[ $first =~ ^[0-9]+$ && $count =~ ^[0-9]+$ && $start =~ ^[0-9]+$ && $size =~ ^[0-9]+$ ]] || fail 'invalid native-root geometry'
(( start % 8 == 0 && size % 8 == 0 && first == start / 8 && count == size / 8 )) || fail 'write range differs from the root partition'
for n in {2..10}; do
 [[ $(cat /sys/class/block/asp0n$n/ro) == 1 ]] || fail "auxiliary namespace $n writable"
done
mkdir -p /run/j81
touch /run/j81/internal-root-verified
