/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	chassis-type = "tablet";
	compatible = "apple,j81\0apple,t7001\0apple,arm-platform";
	model = "Apple iPad Air 2 (Wi-Fi)";

	aliases {
		ausbphy0 = "/soc/bus@20c000000/phy@20c000030";
		serial0 = "/soc/serial@20a0c0000";
	};

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x05>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "apple,typhoon";
			reg = <0x00 0x00>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x02>;
			operating-points-v2 = <0x03>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x04>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x2a>;
		};

		cpu@1 {
			compatible = "apple,typhoon";
			reg = <0x00 0x01>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x02>;
			operating-points-v2 = <0x03>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x04>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x2b>;
		};

		cpu@2 {
			compatible = "apple,typhoon";
			reg = <0x00 0x02>;
			cpu-release-addr = <0x00 0x00>;
			performance-domains = <0x02>;
			operating-points-v2 = <0x03>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x04>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x2c>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x200000>;
			phandle = <0x04>;
		};
	};

	opp-table {
		compatible = "operating-points-v2";
		phandle = <0x03>;

		opp01 {
			opp-hz = <0x00 0x11e1a300>;
			opp-level = <0x01>;
			clock-latency-ns = <0x12c>;
		};

		opp02 {
			opp-hz = <0x00 0x179a7b00>;
			opp-level = <0x02>;
			clock-latency-ns = <0xbf68>;
		};

		opp03 {
			opp-hz = <0x00 0x23c34600>;
			opp-level = <0x03>;
			clock-latency-ns = <0x7918>;
		};

		opp04 {
			opp-hz = <0x00 0x32116200>;
			opp-level = <0x04>;
			clock-latency-ns = <0x7d00>;
		};

		opp05 {
			opp-hz = <0x00 0x433bea00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x7d00>;
		};

		opp06 {
			opp-hz = <0x00 0x52f83c00>;
			opp-level = <0x06>;
			clock-latency-ns = <0x9088>;
		};

		opp07 {
			opp-hz = <0x00 0x5a1f4a00>;
			opp-level = <0x07>;
			clock-latency-ns = <0xa028>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		nonposted-mmio;
		ranges;

		performance-controller@202220000 {
			compatible = "apple,t7000-cluster-cpufreq\0apple,s5l8960x-cluster-cpufreq";
			reg = <0x02 0x2220000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x02>;
		};

		serial@20a0c0000 {
			compatible = "apple,s5l-uart";
			reg = <0x02 0xa0c0000 0x00 0x4000>;
			reg-io-width = <0x04>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x9e 0x04>;
			clocks = <0x05 0x05>;
			clock-names = "uart\0clk_uart_baud0";
			power-domains = <0x06>;
			status = "okay";
		};

		serial@20a0cc000 {
			compatible = "apple,s5l-uart";
			reg = <0x02 0xa0cc000 0x00 0x4000>;
			reg-io-width = <0x04>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xa1 0x04>;
			clocks = <0x05 0x05>;
			clock-names = "uart\0clk_uart_baud0";
			power-domains = <0x07>;
			status = "okay";
			pinctrl-0 = <0x08>;
			pinctrl-names = "default";
			uart-has-rtscts;
		};

		serial@20a0d4000 {
			compatible = "apple,s5l-uart";
			reg = <0x02 0xa0d4000 0x00 0x4000>;
			reg-io-width = <0x04>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xa3 0x04>;
			clocks = <0x05 0x05>;
			clock-names = "uart\0clk_uart_baud0";
			power-domains = <0x09>;
			status = "okay";
			pinctrl-0 = <0x0a>;
			pinctrl-names = "default";

			gauge {
				compatible = "ti,bq27540-hdq-uart";
			};
		};

		spi@20a08c000 {
			compatible = "apple,s5l8960x-spi";
			reg = <0x02 0xa08c000 0x00 0x4000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x9b 0x04>;
			clocks = <0x05>;
			power-domains = <0x0b>;
			pinctrl-0 = <0x0c>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";
		};

		i2c@20a110000 {
			compatible = "apple,t7000-i2c\0apple,i2c";
			reg = <0x02 0xa110000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xae 0x04>;
			pinctrl-0 = <0x0d>;
			pinctrl-names = "default";
			power-domains = <0x0e>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			pmic@3c {
				compatible = "apple,arabela-pmic\0apple,i2c-pmic";
				reg = <0x3c>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				phandle = <0x1c>;

				rtc@5c0 {
					compatible = "apple,arabela-pmic-rtc\0apple,amber-pmic-rtc";
					reg = <0x5c0 0x10>;
					nvmem-cells = <0x0f>;
					nvmem-cell-names = "rtc_offset";
				};

				backlight@600 {
					compatible = "apple,arabela-pmic-bl\0apple,anya-pmic-bl";
					reg = <0x600 0x02>;
				};

				charger {
					compatible = "apple,j81-d2207-charger";
				};

				nvmem@4000 {
					compatible = "apple,pmic-nvmem";
					reg = <0x4000 0x28>;

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <0x01>;
						#size-cells = <0x01>;

						rtc-offset@4 {
							reg = <0x04 0x04>;
							phandle = <0x0f>;
						};
					};
				};
			};
		};

		i2c@20a111000 {
			compatible = "apple,t7000-i2c\0apple,i2c";
			reg = <0x02 0xa111000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xaf 0x04>;
			pinctrl-0 = <0x10>;
			pinctrl-names = "default";
			power-domains = <0x11>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		i2c@20a112000 {
			compatible = "apple,t7000-i2c\0apple,i2c";
			reg = <0x02 0xa112000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xb0 0x04>;
			pinctrl-0 = <0x12>;
			pinctrl-names = "default";
			power-domains = <0x13>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		i2c@20a113000 {
			compatible = "apple,t7000-i2c\0apple,i2c";
			reg = <0x02 0xa113000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xb1 0x04>;
			pinctrl-0 = <0x14>;
			pinctrl-names = "default";
			power-domains = <0x15>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		bus@20c000000 {
			compatible = "apple,t7000-usb-complex\0apple,s5l8960x-usb-complex\0simple-pm-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			dma-ranges = <0x00 0x00 0x08 0x00 0x01 0x00>;
			nonposted-mmio;
			ranges;
			reg = <0x02 0xc900000 0x00 0x100>;
			power-domains = <0x16>;

			phy@20c000030 {
				compatible = "apple,t7000-ausb-phy\0apple,ausb-phy";
				reg = <0x02 0xc000030 0x00 0x20>;
				power-domains = <0x17>;
				#phy-cells = <0x01>;
				phandle = <0x18>;
			};

			usbdev@20c100000 {
				compatible = "apple,t7000-dwc2\0apple,dwc2";
				reg = <0x02 0xc100000 0x00 0x10000>;
				interrupts = <0x00 0xb6 0x04>;
				clocks = <0x05>;
				clock-names = "otg";
				phys = <0x18 0x03>;
				phy-names = "usb2-phy";
				power-domains = <0x19>;
				resets = <0x19>;
				dr_mode = "peripheral";
			};
		};

		iommu@602002000 {
			compatible = "apple,t7000-dart\0apple,s5l8960x-dart";
			reg = <0x06 0x2002000 0x00 0x200000>;
			#iommu-cells = <0x01>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xd8 0x04>;
			power-domains = <0x1a>;
			status = "okay";
			phandle = <0x1b>;
		};

		pcie@610000000 {
			compatible = "apple,t7000-pcie";
			device_type = "pci";
			reg = <0x06 0x10000000 0x00 0x1000000 0x06 0x1004000 0x00 0x1000 0x06 0x1001000 0x00 0x1000 0x06 0x2004000 0x00 0x1000 0x06 0x2001000 0x00 0x1000 0x06 0x3004000 0x00 0x1000 0x06 0x3001000 0x00 0x1000 0x06 0x4004000 0x00 0x1000 0x06 0x4001000 0x00 0x1000 0x06 0x00 0x00 0x2000 0x06 0x1005000 0x00 0x1000 0x06 0x3005000 0x00 0x1000>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xd4 0x04 0x00 0xd7 0x04 0x00 0xda 0x04 0x00 0xdd 0x04>;
			iommu-map = <0x100 0x1b 0x00 0x01>;
			iommu-map-mask = <0xff00>;
			bus-range = <0x00 0x04>;
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			ranges = <0x43000000 0x06 0x20000000 0x06 0x20000000 0x01 0xa0000000 0x2000000 0x00 0xc0000000 0x07 0xc0000000 0x00 0x40000000>;
			power-domains = <0x1a>;
			status = "okay";
			apple,reg-on-pmic = <0x1c>;
			apple,msi-doorbell = <0x00 0xbffff000>;
			msi-controller;
			msi-parent = <0x1d>;
			msi-ranges = <0x01 0x00 0xe0 0x01 0x20>;
			phandle = <0x1d>;

			pci@0,0 {
				device_type = "pci";
				reg = <0x00 0x00 0x00 0x00 0x00>;
				reset-gpios = <0x1e 0xb3 0x01>;
			};
		};

		power-management@20e000000 {
			compatible = "apple,t7000-pmgr\0apple,pmgr\0syscon\0simple-mfd";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x02 0xe000000 0x00 0x24000>;

			power-controller@20000 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20000 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu0";
				apple,always-on;
			};

			power-controller@20008 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20008 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu1";
				apple,always-on;
			};

			power-controller@20010 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20010 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu2";
				apple,always-on;
			};

			power-controller@20040 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20040 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpm";
				apple,always-on;
			};

			power-controller@201f8 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x201f8 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sio_p";
				phandle = <0x1f>;
			};

			power-controller@20100 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20100 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "lio";
				apple,always-on;
			};

			power-controller@20108 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20108 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "iomux";
				apple,always-on;
			};

			power-controller@20110 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20110 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aic";
				apple,always-on;
				phandle = <0x28>;
			};

			power-controller@20118 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20118 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "debug";
			};

			power-controller@20120 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20120 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "dwi";
			};

			power-controller@20128 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20128 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "gpio";
				phandle = <0x29>;
			};

			power-controller@20130 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20130 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca0";
				power-domains = <0x1f>;
			};

			power-controller@20138 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20138 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca1";
				power-domains = <0x1f>;
			};

			power-controller@20140 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20140 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca2";
				power-domains = <0x1f>;
			};

			power-controller@20148 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20148 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca3";
				power-domains = <0x1f>;
			};

			power-controller@20150 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20150 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca4";
				power-domains = <0x1f>;
			};

			power-controller@20158 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20158 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "pwm0";
				power-domains = <0x1f>;
			};

			power-controller@20160 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20160 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "i2c0";
				power-domains = <0x1f>;
				phandle = <0x0e>;
			};

			power-controller@20168 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20168 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "i2c1";
				power-domains = <0x1f>;
				phandle = <0x11>;
			};

			power-controller@20170 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20170 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "i2c2";
				power-domains = <0x1f>;
				phandle = <0x13>;
			};

			power-controller@20178 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20178 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "i2c3";
				power-domains = <0x1f>;
				phandle = <0x15>;
			};

			power-controller@20180 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20180 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "spi0";
				power-domains = <0x1f>;
			};

			power-controller@20188 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20188 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "spi1";
				power-domains = <0x1f>;
			};

			power-controller@20190 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20190 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "spi2";
				power-domains = <0x1f>;
			};

			power-controller@20198 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x20198 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "spi3";
				power-domains = <0x1f>;
				phandle = <0x0b>;
			};

			power-controller@201a0 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x201a0 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "uart0";
				power-domains = <0x1f>;
				phandle = <0x06>;
			};

			power-controller@201a8 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x201a8 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "uart1";
				power-domains = <0x1f>;
			};

			power-controller@201b0 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x201b0 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "uart2";
				power-domains = <0x1f>;
			};

			power-controller@201b8 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x201b8 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "uart3";
				power-domains = <0x1f>;
				phandle = <0x07>;
			};

			power-controller@201c0 {
				compatible = "apple,t7000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x201c0 0x04>;
				#power-domain-cells = <0x00>;
