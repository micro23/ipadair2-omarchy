+/*
+ * Patch 0072: Apple's bus driver writes each common ring's id (u16 at +0) and type (u8 at +2) into the ring memory
+ * table. Linux leaves them alone, and the C2 firmware leaves them zero (run 12 dump), so every ring looks like
+ * id 0 / type 0. Apple's values per Linux ring number (H2D ctrl, H2D rxpost, D2H ctrl, D2H tx, D2H rx):
+ * id {0,1,0,1,2}, type {0,2,1,4,3}. brcmfmac.h1b_ring_ids=1 writes them (word = type << 16 | id).
+ */
+static unsigned int h1b_ring_ids_on;
+module_param_named(h1b_ring_ids, h1b_ring_ids_on, uint, 0444);
+MODULE_PARM_DESC(h1b_ring_ids, "J81 test: 1 write Apple's ring id/type words into the common-ring memory table");
+
+static const u32 h1b_apple_ring_idtype[BRCMF_NROF_COMMON_MSGRINGS] = {
+	0x00000000, 0x00020001, 0x00010000, 0x00040001, 0x00030002
+};
+
+static void h1b_write_ring_idtype(struct brcmf_pciedev_info *devinfo, u32 ring_id, u32 tcm_ring_phys_addr)
+{
+	if (!h1b_ring_ids_on)
+		return;
+	brcmf_pcie_write_tcm32(devinfo, tcm_ring_phys_addr, h1b_apple_ring_idtype[ring_id]);
+	dev_info(&devinfo->pdev->dev, "t7000-h1b: ring %u id/type word 0x%08x written (h1b_ring_ids)\n", ring_id,
+		 h1b_apple_ring_idtype[ring_id]);
+}
