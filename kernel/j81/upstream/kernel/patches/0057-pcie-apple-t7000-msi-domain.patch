diff --git a/arch/arm64/boot/dts/apple/t7001-air2.dtsi b/arch/arm64/boot/dts/apple/t7001-air2.dtsi
--- a/arch/arm64/boot/dts/apple/t7001-air2.dtsi
+++ b/arch/arm64/boot/dts/apple/t7001-air2.dtsi
@@ -194,7 +194,17 @@
 
 	/*
 	 * MSI doorbell page from the ADT (`msi-address`). The DART reserves it so DMA
-	 * mappings never use it. No MSI domain exists yet, so nothing writes to it.
+	 * mappings never use it, and the MSI domain composes messages to it.
 	 */
 	apple,msi-doorbell = <0x0 0xbffff000>;
+
+	/*
+	 * The controller's 32 hardware MSI vectors are AIC lines 224..255 (ADT
+	 * `msi-vector-offset` 224, `#msi-vectors` 32; the AIC reports 256 IRQs). Port 1 owns
+	 * vectors 8..15. These three properties are declared together with the driver's
+	 * MSI domain and must not be added without it.
+	 */
+	msi-controller;
+	msi-parent = <&pcie>;
+	msi-ranges = <&aic AIC_IRQ 224 IRQ_TYPE_EDGE_RISING 32>;
 };
