+/*
+ * Per-controller IOVA window for PCI devices (patch 0063). The T7000 PCIe DART translates only
+ * [vm-offset, vm-offset + vm-size) in Apple's configuration (J81: [0x80000000, 0xbffff000),
+ * immediately below the MSI doorbell page), and Apple's software rebases IOVAs to PTE page 0 by
+ * subtracting vm-offset. A PCI device behind `iommu-map` cannot carry a window in its iommu
+ * specifier, so the window comes from the host bridge's node: `apple,iova-window` = <start end>
+ * (two 64-bit values, end exclusive), plus the boolean `apple,iova-rebase` to select Apple's
+ * rebased PTE indexing (without it the raw, un-rebased indexing is used inside the same window).
+ */
+static struct device_node *apple_dart_pci_bridge_node(struct device *dev)
+{
+	struct pci_host_bridge *bridge = pci_find_host_bridge(to_pci_dev(dev)->bus);
+	struct device *parent = bridge ? bridge->dev.parent : NULL;
+
+	return parent ? parent->of_node : NULL;
+}
+
+static bool apple_dart_pci_iova_window(struct device *dev, u64 *start, u64 *end)
+{
+	struct device_node *np = apple_dart_pci_bridge_node(dev);
+
+	return np && !of_property_read_u64_index(np, "apple,iova-window", 0, start) &&
+	       !of_property_read_u64_index(np, "apple,iova-window", 1, end);
+}
+
+/* Window [start, end) as an inclusive DMA range inside the DART's address space. */
+static int apple_dart_window_range(u64 start, u64 end, u32 pgsize, u32 ias,
+				   dma_addr_t *dma_min, dma_addr_t *dma_max)
+{
+	if (start >= end || !IS_ALIGNED(start, pgsize) || !IS_ALIGNED(end, pgsize))
+		return -EINVAL;
+	if (end - 1 > DMA_BIT_MASK(ias))
+		return -EINVAL;
+	*dma_min = start;
+	*dma_max = end - 1;
+	return 0;
+}
