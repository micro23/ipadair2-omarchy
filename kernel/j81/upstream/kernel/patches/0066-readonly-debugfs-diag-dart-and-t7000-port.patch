@@ -613,6 +616,37 @@
 		cap_ptr, old, new, readback);
 }
 
+#ifdef CONFIG_PCIE_APPLE_T7000_DEBUGFS_DIAG
+/*
+ * Read-only dump of port 1's controller registers for the J81 Wi-Fi bring-up (patch 0066), as
+ * /sys/kernel/debug/t7000-pcie/port1_regs: link control and state, the port event status and mask
+ * (+0x100/+0x104; the iOS handler reads status and acknowledges with a separate write, so reading
+ * is side-effect free), the MSI configuration and the M1-named doorbell register that iOS never
+ * programs (+0x168, read as 0 on this hardware). Nothing here writes.
+ */
+static void t7000_pcie_debugfs(struct device *dev, void __iomem *ctrl)
+{
+	static const struct debugfs_reg32 regs[] = {
+		{ "link_start_0x80", 0x080 }, { "state_0x88", 0x088 }, { "state_0x8c", 0x08c },
+		{ "event_status_0x100", 0x100 }, { "event_mask_0x104", 0x104 },
+		{ "msicfg_0x124", 0x124 }, { "msibase_0x128", 0x128 }, { "msiaddr_0x168", 0x168 },
+	};
+	struct debugfs_regset32 *regset;
+	struct dentry *dir;
+
+	regset = devm_kzalloc(dev, sizeof(*regset), GFP_KERNEL);
+	if (!regset)
+		return;
+	regset->regs = regs;
+	regset->nregs = ARRAY_SIZE(regs);
+	regset->base = ctrl;
+	dir = debugfs_create_dir("t7000-pcie", NULL);
+	debugfs_create_regset32("port1_regs", 0444, dir, regset);
+}
+#else
+static inline void t7000_pcie_debugfs(struct device *dev, void __iomem *ctrl) { }
+#endif
+
