--- /dev/null
+++ b/drivers/power/supply/j81_d2207_charger.c
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only Apple J81 (T7001) D2207 charger reporting.
+ *
+ * The register locations and conversions are recovered from Apple's
+ * D2207 power-source implementation and checked against live J81 reads.
+ * This driver intentionally has no set_property callback: charging policy
+ * writes remain a separate, meter-backed step.
+ */
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#define J81_D2207_INPUT_CURRENT		0x04c0
+#define J81_D2207_CHARGE_CURRENT_MAX	0x04cf
+struct j81_d2207_charger {
+	struct regmap *regmap;
+};
+/* Apple encodes 75..3262 mA as floor((8*mA - 600) / 100). */
+static int j81_d2207_input_current_ma(unsigned int code)
+{
+	if (code >= 0xfe)
+		return 3262;
+	return 75 + (100 * code + 7) / 8;
+}
+static enum power_supply_property j81_d2207_properties[] = {
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
+};
+static int j81_d2207_get_property(struct power_supply *psy,
+					 enum power_supply_property property,
+					 union power_supply_propval *val)
+{
+	struct j81_d2207_charger *charger = power_supply_get_drvdata(psy);
+	unsigned int code;
+	int ret;
+	switch (property) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = regmap_read(charger->regmap, J81_D2207_INPUT_CURRENT, &code);
+		if (ret)
+			return ret;
+		val->intval = j81_d2207_input_current_ma(code) * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		ret = regmap_read(charger->regmap, J81_D2207_CHARGE_CURRENT_MAX,
+				  &code);
+		if (ret)
+			return ret;
+		/* 0x3c is 3000 mA and 0x3f is the 3150 mA hardware ceiling. */
+		val->intval = (code & 0x3f) * 50000;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+static const struct power_supply_desc j81_d2207_desc = {
+	.name = "j81-d2207-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = j81_d2207_properties,
+	.num_properties = ARRAY_SIZE(j81_d2207_properties),
+	.get_property = j81_d2207_get_property,
+};
+static int j81_d2207_probe(struct platform_device *pdev)
+{
+	struct j81_d2207_charger *charger;
+	struct power_supply_config config = {
+		.fwnode = dev_fwnode(&pdev->dev),
+	};
+	charger = devm_kzalloc(&pdev->dev, sizeof(*charger), GFP_KERNEL);
+	if (!charger)
+		return -ENOMEM;
+	charger->regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!charger->regmap)
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "parent PMIC regmap unavailable\n");
+	config.drv_data = charger;
+	return PTR_ERR_OR_ZERO(devm_power_supply_register(&pdev->dev,
+							 &j81_d2207_desc, &config));
+}
+static const struct of_device_id j81_d2207_of_match[] = {
+	{ .compatible = "apple,j81-d2207-charger" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, j81_d2207_of_match);
+static struct platform_driver j81_d2207_driver = {
+	.probe = j81_d2207_probe,
+	.driver = {
+		.name = "j81-d2207-charger",
+		.of_match_table = j81_d2207_of_match,
+	},
+};
+module_platform_driver(j81_d2207_driver);
+MODULE_DESCRIPTION("Read-only Apple J81 D2207 charger reporting");
+MODULE_LICENSE("GPL");
