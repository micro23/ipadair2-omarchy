+
+/*
+ * Poll the firmware console every 100 ms for the first 3 s after the interrupt is set up (read-only TCM reads),
+ * so the time series of what the firmware prints while the first control query is pending is visible even when no
+ * interrupt ever arrives (the console is otherwise only read from the interrupt handler).
+ */
+static struct timer_list h1b_console_timer;
+static struct brcmf_pciedev_info *h1b_poll_devinfo;
+static int h1b_poll_ticks;
+static bool h1b_poll_started;
+
+static void h1b_console_tick(struct timer_list *t)
+{
+	struct brcmf_pciedev_info *devinfo = h1b_poll_devinfo;
+
+	if (!devinfo || ++h1b_poll_ticks > 30)
+		return;
+	if (devinfo->state == BRCMFMAC_PCIE_STATE_UP)
+		brcmf_pcie_bus_console_read(devinfo, true);
+	mod_timer(&h1b_console_timer, jiffies + msecs_to_jiffies(100));
+}
+
+static void h1b_console_poll_start(struct brcmf_pciedev_info *devinfo)
+{
+	h1b_poll_devinfo = devinfo;
+	h1b_poll_ticks = 0;
+	h1b_poll_started = true;
+	timer_setup(&h1b_console_timer, h1b_console_tick, 0);
+	mod_timer(&h1b_console_timer, jiffies + msecs_to_jiffies(100));
+}
+
+static void h1b_console_poll_stop(void)
+{
+	if (!h1b_poll_started)
+		return;
+	timer_delete_sync(&h1b_console_timer);
+	h1b_poll_devinfo = NULL;
+	h1b_poll_started = false;
+}
