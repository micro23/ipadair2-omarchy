 /*
- * Test only (patch 0085): apple_dart.h1b_apple_init=1 gives the J81 PCIe DART (602002000.iommu) Apple's start-up order from
- * AppleS5L8960XDART::_dartRecoverFromPowerdown: the error-reflector write (+0x24 = error-reflector >> 12) BEFORE anything is read, then
- * fetch-config (+0x30) and diag-config (+0x20) from the ADT node dart-apcie1. Linux starts by reading +0x00 and writes neither. Run 32: the
- * firmware's first DMA read through this DART resets the machine; this tests whether the missing configuration is why.
+ * Apple's AppleS5L8960XDART::_dartRecoverFromPowerdown order for the J81 PCIe DART (patch 0089, from patches 0085/0088): the error-reflector
+ * value is written to +0x24 BEFORE anything is read, then fetch-config (+0x30) and diag-config (+0x20). The values come from the device tree
+ * (apple,error-reflector, apple,fetch-config, apple,diag-config; the ADT node dart-apcie1). Without the error reflector a DART fault is not
+ * reported as an interrupt: the SoC resets silently (runs 13-31), so the first device DMA read killed the machine. Linux used to start with a read
+ * of +0x00 and write none of these.
  */
-#ifdef CONFIG_APPLE_DART_H1B_DIAG
-#define H1B_DART_ERROR_REFLECTOR	0x24
-#define H1B_DART_DIAG_CONFIG		0x20
-#define H1B_DART_FETCH_CONFIG		0x30
-#define H1B_APCIE1_ERROR_REFLECTOR	0x0020ffff
-#define H1B_APCIE1_DIAG_CONFIG		0x00000100
-#define H1B_APCIE1_FETCH_CONFIG		0x000e0303
+#define APPLE_DART_S5L8960X_DIAG_CONFIG		0x20
+#define APPLE_DART_S5L8960X_ERROR_REFLECTOR	0x24
+#define APPLE_DART_S5L8960X_FETCH_CONFIG	0x30
+
+/* Module parameters stay as overrides (1 forces on, e.g. for another device) on top of the device-tree properties. */
 static unsigned int apple_dart_h1b_apple_init;
 module_param_named(h1b_apple_init, apple_dart_h1b_apple_init, uint, 0444);
-MODULE_PARM_DESC(h1b_apple_init, "J81 test: 1 write the J81 PCIe DART's error-reflector first, then fetch/diag-config, as Apple does");
+MODULE_PARM_DESC(h1b_apple_init, "J81: 1 force Apple's error-reflector/fetch/diag-config start-up with the J81 PCIe DART values (normally from the device tree)");
 
-static bool apple_dart_h1b_is_apcie1(struct apple_dart *dart)
+static void apple_dart_parse_apple_init(struct apple_dart *dart)
 {
-	return apple_dart_h1b_apple_init && dart->hw->type == DART_S5L8960X &&
-	       !strncmp(dev_name(dart->dev), "602002000.", 10);
+	struct device_node *np = dart->dev->of_node;
+
+	if (dart->hw->type != DART_S5L8960X)
+		return;
+
+	if (!of_property_read_u32(np, "apple,error-reflector", &dart->error_reflector)) {
+		dart->has_apple_init = 1;
+		of_property_read_u32(np, "apple,fetch-config", &dart->fetch_config);
+		of_property_read_u32(np, "apple,diag-config", &dart->diag_config);
+	} else if (apple_dart_h1b_apple_init && !strncmp(dev_name(dart->dev), "602002000.", 10)) {
+		dart->has_apple_init = 1;
+		dart->error_reflector = 0x0020ffff;
+		dart->fetch_config = 0x000e0303;
+		dart->diag_config = 0x00000100;
+	}
 }
-#else
-static inline bool apple_dart_h1b_is_apcie1(struct apple_dart *dart) { return false; }
-#endif
 
