+
+/*
+ * Apple S5L UART (J81 Bluetooth UART3): the upper half of UBRDIV (+0x28) is a sampling-factor field. Measured on the iPad (research/2026-10-11-uart3-register-capture.md, rounds 8-9):
+ * baud = clk / ((16 - i) x (div + 1)) for i = 0..12 (factor 16 down to 4), with UCON/UFCON untouched; i = 0 is the legacy divide-by-16 mode, so 3,000,000 baud on the
+ * 24 MHz clock is factor 8, div 0 (+0x28 = 0x80000). Pick the (factor, div) pair with the smallest rate error; ties keep the larger factor (finer sampling).
+ */
+static void apple_s5l_pick_baud(unsigned long clk, unsigned int baud, unsigned int *factor, unsigned int *div)
+{
+	unsigned long best_err = ULONG_MAX;
+	unsigned int f;
+
+	*factor = 16;
+	*div = 0;
+	if (!baud)
+		return;
+
+	for (f = 16; f >= 4; f--) {
+		unsigned long denom = (unsigned long)f * baud;
+		unsigned long d = (clk + denom / 2) / denom;	/* d = div + 1 */
+		unsigned long actual, err;
+
+		if (d < 1)
+			d = 1;
+		if (d > 0x10000)
+			continue;
+		actual = clk / (f * d);
+		err = actual > baud ? actual - baud : baud - actual;
+		if (err < best_err) {
+			best_err = err;
+			*factor = f;
+			*div = d - 1;
+		}
+	}
+}
 
