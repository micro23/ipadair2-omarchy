@@ -102,6 +99,36 @@
 #define T7000_PCIE_DBI_GATE_SELECTOR		0x08000800
 #define T7000_PCIE_DBI_GATE_ECAM_OFFSET	0x88bc
 
+/*
+ * ADT-recovered apcie-config-tunables/dbi-overrides records for port 1,
+ * decoded from the real J81 ADT (research/t7000-pcie-hardware-
+ * findings.md's controller-records table). Each is a little-endian
+ * (offset, clear-mask, set-value) triple; Apple's own helper computes
+ * new = (old & ~clear-mask) | set-value. dbi-overrides offsets are
+ * already the resolved ECAM addresses (0x8024/0x807c/0x8b44), following
+ * the confirmed configRead32/configWrite32 address formula -- see
+ * research/t7000-pcie-hardware-findings.md's "Vtable slots 0x5e0/0x5e8
+ * resolved" section. apcie-config-tunables reuses the already-mapped
+ * direct port-controller window (T7000_PCIE_TUNE_CONFIG_A/B/C above).
+ */
+struct t7000_pcie_rmw_record {
+	u32 offset;
+	u32 clear_mask;
+	u32 set_value;
+};
+
+static const struct t7000_pcie_rmw_record t7000_pcie_dbi_overrides[3] = {
+	{ 0x8024, 0x00000001, 0x00000001 },
+	{ 0x807c, 0x00000400, 0x00000000 },
+	{ 0x8b44, 0x00000003, 0x00000002 },
+};
+
+static const struct t7000_pcie_rmw_record t7000_pcie_config_tunables[3] = {
+	{ T7000_PCIE_TUNE_CONFIG_A, 0x000000ff, 0x00000028 },
+	{ T7000_PCIE_TUNE_CONFIG_B, 0x00000003, 0x00000003 },
+	{ T7000_PCIE_TUNE_CONFIG_C, 0x00000001, 0x00000001 },
+};
+
 /* Board port 1 is J81's only populated port; this driver never touches
  * ports 2-4.
  */
