+			return;
+		}
+		if ((off | len) & 3 || !len || len > H1B_Q_ROM_MAX || !devinfo->ci || off >= devinfo->ci->rambase ||
+		    len > devinfo->ci->rambase - off || (u64)off + len > bar2) {
+			h1b_q_printf("error: rom needs OFF,LEN multiples of 4, 0 < LEN <= 0x%x, OFF+LEN <= RAM base 0x%x and <= BAR2 size\n",
+				     H1B_Q_ROM_MAX, devinfo->ci ? devinfo->ci->rambase : 0);
+			return;
+		}
+		dev_warn(&devinfo->pdev->dev, "t7000-h1b: ROM read 0x%x len 0x%x\n", off, len);
+		h1b_q_tcm(devinfo, "rom", off, len);
 	} else if (!strncmp(cmd, "shared", 6)) {
 		ring_info = devinfo->shared.ring_info_addr;
