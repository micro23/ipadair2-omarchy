 #define BCM_CC_REV_GCI_FIRST	49
 #define BCM_CC_REV_GCI_EXCEPT	51
 
+/* OTP shadow window in ChipCommon (patch 0062): 512 16-bit words at +0x800. */
+#define BCM_CC_SROMOTP		0x800
+#define BCM_SHADOW_MAX_WORDS	512
+
 enum bcm_nvm_path {
 	BCM_PATH_STOP,		/* unsupported: do not guess a mapping */
 	BCM_PATH_CHIPCOMMON,	/* ChipCommon shadow window (at most 512 words) */
@@ -137,6 +151,82 @@
 	}
 }
 
+/*
+ * Pure: the number of 16-bit shadow words to capture, or 0 with the reason. Only the ChipCommon
+ * path with the 40 nm layout and OTP already selected (both published predicates agree, no
+ * SPROM) qualifies; the span follows the 40 nm size formula ((encoding + 1) * 1024 bits / 16)
+ * and never exceeds the 512-word ChipCommon window. Nothing is extrapolated.
+ */
+static u32 bcm_shadow_words(const struct bcm_meta *m, const char **why)
+{
+	u32 enc = (m->capabilities & BCM_CAP_OTPSIZE_MASK) >> BCM_CAP_OTPSIZE_SHIFT;
+	u32 words;
+
+	*why = "";
+	if (bcm_classify(m, why) != BCM_PATH_CHIPCOMMON) {
+		if (!(*why)[0])
+			*why = "mapping path is not chipcommon";
+		return 0;
+	}
+	if (m->sromcontrol & BCM_SRC_PRESENT) {
+		*why = "SPROM present: the published predicates disagree";
+		return 0;
+	}
+	if (!((m->sromcontrol & BCM_SRC_OTPSEL) && (m->sromcontrol & BCM_SRC_OTPPRESENT))) {
+		*why = "OTP is not both present and selected (a selector write would be needed; refused)";
+		return 0;
+	}
+	if (!enc) {
+		*why = "OTP size encoding 0 (none)";
+		return 0;
+	}
+	words = ((enc + 1) * 1024) / 16;
+	if (words > BCM_SHADOW_MAX_WORDS) {
+		*why = "derived span exceeds the ChipCommon shadow window";
+		return 0;
+	}
+	return words;
+}
+
+static struct debugfs_blob_wrapper bcm_shadow_blob;
+
+/* Capture the shadow (window must already be ChipCommon). Read-only; never logs the data. */
+static void bcm_capture_shadow(struct pci_dev *pdev, void __iomem *bar, const struct bcm_meta *m)
+{
+	struct device *dev = &pdev->dev;
+	const char *why;
+	u32 words = bcm_shadow_words(m, &why), i, ones = 0, zeros = 0;
+	struct dentry *file;
+	u16 *buf, w;
+
+	if (!words) {
+		dev_info(dev, BCM_PROBE_PREFIX "shadow: not captured - %s\n", why);
+		return;
+	}
+	buf = kmalloc_array(words, sizeof(*buf), GFP_KERNEL);
+	if (!buf) {
+		dev_err(dev, BCM_PROBE_PREFIX "shadow: no memory for %u words\n", words);
+		return;
+	}
+	for (i = 0; i < words; i++) {
+		w = ioread16(bar + BCM_CC_SROMOTP + 2 * i);
+		buf[i] = w;
+		ones += w == 0xffff;
+		zeros += w == 0;
+	}
+	bcm_shadow_blob.data = buf;
+	bcm_shadow_blob.size = words * sizeof(*buf);
+	file = debugfs_create_blob("t7000-bcm-otp-shadow", 0400, NULL, &bcm_shadow_blob);
+	if (IS_ERR_OR_NULL(file)) {
+		dev_err(dev, BCM_PROBE_PREFIX "shadow: debugfs file not created, capture dropped\n");
+		kfree(buf);
+		return;
+	}
+	dev_info(dev, BCM_PROBE_PREFIX "shadow: captured %u words (%u bytes) crc32=0x%08x allones=%u zero=%u; "
+		 "bytes in debugfs t7000-bcm-otp-shadow (root only, private, not for Git)\n",
+		 words, words * 2, crc32_le(~0, (const u8 *)buf, words * 2), ones, zeros);
+}
+
 /* Select a backplane window and verify the device took it. */
 static int bcm_select_window(struct pci_dev *pdev, u32 backplane)
 {
@@ -242,6 +332,8 @@
 	m->otplayout = ioread32(bar + BCM_CC_OTPLAYOUT);
 	m->sromcontrol = ioread32(bar + BCM_CC_SROMCONTROL);
 	m->have_regs = true;
+	if (IS_ENABLED(CONFIG_PCIE_APPLE_T7000_BCM_PROBE_SHADOW))
+		bcm_capture_shadow(pdev, bar, m);
 	return 0;
 }
 
